---
interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  slug: string;
  image?: string;
}

const { title, description, date, category, slug, image } = Astro.props;

const categoryMap: Record<string, { label: string; class: string }> = {
  'marketing-ia': { label: 'Marketing & IA', class: 'tag-marketing' },
  'fe': { label: 'Fe', class: 'tag-fe' },
  'politica-cultura': { label: 'Política y Cultura', class: 'tag-politica' },
  'musica': { label: 'Música', class: 'tag-musica' },
};

const cat = categoryMap[category] || { label: category, class: 'tag-marketing' };
const formattedDate = date.toLocaleDateString('es-MX', { year: 'numeric', month: 'short', day: 'numeric' });
const href = `/articulos/${slug}`;
---

<a href={href} class="card group block hover:no-underline">
  {image && (
    <img src={image} alt={title} class="w-full h-48 object-cover rounded-lg mb-4" loading="lazy" />
  )}
  <div class="flex items-center gap-3 mb-2">
    <span class={`tag ${cat.class}`}>{cat.label}</span>
    <time datetime={date.toISOString()} class="text-xs text-muted">{formattedDate}</time>
  </div>
  <h3 class="text-lg font-semibold group-hover:text-accent transition-colors mb-2">{title}</h3>
  <p class="text-sm text-muted line-clamp-2">{description}</p>
</a>
