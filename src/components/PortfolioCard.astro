---
interface Props {
  title: string;
  description: string;
  image: string;
  categories: string[];
  video?: string;
  link?: string;
}

const { title, description, image, categories, video, link } = Astro.props;
---

<div class="card group overflow-hidden">
  <div class="relative aspect-video mb-4 rounded-lg overflow-hidden bg-gray-100">
    {video ? (
      <video
        src={video}
        poster={image}
        class="w-full h-full object-cover"
        muted
        loop
        playsinline
        preload="none"
        onmouseenter="this.play()"
        onmouseleave="this.pause();this.currentTime=0"
      />
    ) : (
      <img src={image} alt={title} class="w-full h-full object-cover" loading="lazy" />
    )}
  </div>
  <div class="flex flex-wrap gap-1.5 mb-2">
    {categories.map(cat => (
      <span class="text-xs font-medium bg-gray-100 text-gray-600 px-2 py-0.5 rounded-full">{cat}</span>
    ))}
  </div>
  <h3 class="text-lg font-semibold mb-2">{title}</h3>
  <p class="text-sm text-muted mb-3">{description}</p>
  {link && (
    <a href={link} target="_blank" rel="noopener" class="text-sm text-accent">Ver sitio &rarr;</a>
  )}
</div>
