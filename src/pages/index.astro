---
import Base from '../layouts/Base.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getCollection } from 'astro:content';

const allArticles = await getCollection('articulos', ({ data }) => !data.draft);
const sortedArticles = allArticles.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title="Inicio">
  <!-- Hero -->
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16 md:py-24">
    <p class="text-lg md:text-xl text-muted mb-6 leading-relaxed">
      Me complico la vida pensando en marketing, cultura, política, música y Dios.<br class="hidden sm:block" />
      Acá están mis trabajos y conclusiones.
    </p>
    <div class="flex flex-wrap gap-3">
      <a href="/sobre" class="btn btn-primary">Conóceme</a>
      <a href="/portafolio" class="btn btn-outline">Ver portafolio</a>
    </div>
  </section>

  <!-- Latest content feed -->
  <section class="max-w-content mx-auto px-4 sm:px-6 pb-16">
    <h2 class="text-2xl font-bold mb-8">Lo más reciente</h2>

    {sortedArticles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        {sortedArticles.map((article) => (
          <ArticleCard
            title={article.data.title}
            description={article.data.description}
            date={article.data.date}
            category={article.data.category}
            slug={article.id}
            image={article.data.image}
          />
        ))}
      </div>
    ) : (
      <p class="text-muted">Pronto habrá contenido aquí.</p>
    )}
  </section>

  <!-- Start Here -->
  <section class="max-w-content mx-auto px-4 sm:px-6 pb-16">
    <div class="bg-warm rounded-2xl p-8 md:p-12">
      <h2 class="text-2xl font-bold mb-4">¿Primera vez aquí?</h2>
      <p class="text-muted mb-6 max-w-2xl">
        Soy publicista, músico y pensador. Cubano en México. Este sitio reúne todo lo que hago:
        desde proyectos de marketing hasta reflexiones sobre fe y libertad.
      </p>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
        <a href="/marketing-ia" class="block p-4 bg-white rounded-xl hover:shadow-md transition-shadow hover:no-underline text-center">
          <span class="text-2xl mb-2 block">📊</span>
          <span class="text-sm font-medium text-primary">Marketing & IA</span>
        </a>
        <a href="/fe" class="block p-4 bg-white rounded-xl hover:shadow-md transition-shadow hover:no-underline text-center">
          <span class="text-2xl mb-2 block">✝️</span>
          <span class="text-sm font-medium text-primary">Fe</span>
        </a>
        <a href="/politica-cultura" class="block p-4 bg-white rounded-xl hover:shadow-md transition-shadow hover:no-underline text-center">
          <span class="text-2xl mb-2 block">🌎</span>
          <span class="text-sm font-medium text-primary">Política</span>
        </a>
        <a href="/musica" class="block p-4 bg-white rounded-xl hover:shadow-md transition-shadow hover:no-underline text-center">
          <span class="text-2xl mb-2 block">🎵</span>
          <span class="text-sm font-medium text-primary">Música</span>
        </a>
      </div>
    </div>
  </section>
</Base>
