---
import Base from '../layouts/Base.astro';
---

<Base
  title="Contacto"
  description="Contacta a Ismael Guimarais para proyectos de marketing, colaboraciones, consultoría digital o simplemente para conversar."
>
  <section class="max-w-3xl mx-auto px-4 sm:px-6 py-12">
    <h1 class="section-title">Contacto</h1>
    <p class="section-subtitle">
      Si quieres trabajar conmigo, colaborar, o simplemente conversar sobre alguno de los temas
      que toco aquí — escríbeme.
    </p>

    <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
      <!-- For work -->
      <div class="card">
        <h3 class="text-lg font-semibold mb-2">💼 Trabajo</h3>
        <p class="text-sm text-muted mb-4">
          Proyectos de branding, web, video, consultoría digital o estrategia de marketing.
        </p>
        <a href="mailto:ismaelguimarais@gmail.com" class="text-accent text-sm">
          ismaelguimarais@gmail.com
        </a>
      </div>

      <!-- General -->
      <div class="card">
        <h3 class="text-lg font-semibold mb-2">💬 General</h3>
        <p class="text-sm text-muted mb-4">
          Conversaciones sobre fe, política, cultura, música. Ideas, debate, colaboración.
        </p>
        <a href="https://x.com/IsmaGuimarais" target="_blank" rel="noopener" class="text-accent text-sm">
          @IsmaGuimarais en X
        </a>
      </div>
    </div>

    <!-- Social links -->
    <div class="bg-warm rounded-2xl p-8">
      <h2 class="text-xl font-semibold mb-4">Redes sociales</h2>
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
        <a href="https://youtube.com/@IsmaelGuimarais" target="_blank" rel="noopener"
           class="flex items-center gap-2 p-3 bg-white rounded-xl hover:shadow-md transition-shadow hover:no-underline">
          <span class="text-xl">▶️</span>
          <span class="text-sm font-medium text-primary">YouTube</span>
        </a>
        <a href="https://x.com/IsmaGuimarais" target="_blank" rel="noopener"
           class="flex items-center gap-2 p-3 bg-white rounded-xl hover:shadow-md transition-shadow hover:no-underline">
          <span class="text-xl">𝕏</span>
          <span class="text-sm font-medium text-primary">Twitter / X</span>
        </a>
        <a href="https://www.instagram.com/ismaguimarais/" target="_blank" rel="noopener"
           class="flex items-center gap-2 p-3 bg-white rounded-xl hover:shadow-md transition-shadow hover:no-underline">
          <span class="text-xl">📸</span>
          <span class="text-sm font-medium text-primary">Instagram</span>
        </a>
        <a href="https://open.spotify.com/intl-es/artist/6FBiAmYUgClucZddGctkwd" target="_blank" rel="noopener"
           class="flex items-center gap-2 p-3 bg-white rounded-xl hover:shadow-md transition-shadow hover:no-underline">
          <span class="text-xl">🎵</span>
          <span class="text-sm font-medium text-primary">Spotify</span>
        </a>
      </div>
    </div>
  </section>
</Base>
