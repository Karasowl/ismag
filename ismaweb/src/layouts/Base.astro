---
import '../styles/global.css';
import { t, getLocalePath, type Locale } from '../i18n/translations';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: string;
  canonical?: string;
  locale?: Locale;
}

const {
  title,
  description = 'Me complico la vida pensando en marketing, cultura, política, música y Dios. Acá están mis trabajos y conclusiones.',
  image = '/og-default.jpg',
  type = 'website',
  canonical,
  locale = 'es',
} = Astro.props;

const i = t(locale);
const altLocale = locale === 'es' ? 'en' : 'es';
const siteUrl = 'https://www.guimarais.com';
const fullTitle = title === 'Inicio' || title === 'Home' ? 'Ismael Guimarais' : `${title} — Ismael Guimarais`;
const ogImage = image.startsWith('http') ? image : `${siteUrl}${image}`;
const canonicalUrl = canonical || new URL(Astro.url.pathname, siteUrl).toString();
const currentPath = Astro.url.pathname;

// Get the equivalent path in the other language
function getAltPath(): string {
  if (locale === 'es') {
    return `/en${currentPath === '/' ? '' : currentPath}`;
  } else {
    return currentPath.replace(/^\/en/, '') || '/';
  }
}
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:type" content={type} />
    <meta property="og:locale" content={locale === 'es' ? 'es_MX' : 'en_US'} />
    <meta property="og:site_name" content="Ismael Guimarais" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:site" content="@IsmaGuimarais" />

    <link rel="alternate" hreflang={altLocale} href={`${siteUrl}${getAltPath()}`} />
    <link rel="alternate" hreflang={locale} href={canonicalUrl} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="sticky top-0 z-50 bg-cream/95 backdrop-blur-sm border-b border-primary/5">
      <nav class="max-w-content mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-16">
          <a href={getLocalePath('/', locale)} class="font-display text-2xl font-bold text-primary hover:no-underline">
            Ismael Guimarais
          </a>

          <div class="hidden lg:flex items-center gap-1">
            <a href={getLocalePath('/marketing-ia', locale)} class:list={["nav-link", currentPath.includes('marketing-ia') && "!text-primary font-semibold"]}>{i.nav.marketing}</a>
            <a href={getLocalePath('/fe', locale)} class:list={["nav-link", currentPath.includes('/fe') && "!text-primary font-semibold"]}>{i.nav.fe}</a>
            <a href={getLocalePath('/politica-cultura', locale)} class:list={["nav-link", currentPath.includes('politica-cultura') && "!text-primary font-semibold"]}>{i.nav.politica}</a>
            <a href={getLocalePath('/musica', locale)} class:list={["nav-link", currentPath.includes('musica') && "!text-primary font-semibold"]}>{i.nav.musica}</a>
            <a href={getLocalePath('/portafolio', locale)} class:list={["nav-link", currentPath.includes('portafolio') && "!text-primary font-semibold"]}>{i.nav.portafolio}</a>
            <a href={getLocalePath('/sobre', locale)} class:list={["nav-link", currentPath.includes('sobre') && "!text-primary font-semibold"]}>{i.nav.sobre}</a>
            <span class="mx-2 text-gray-200">|</span>
            <a href={getAltPath()} class="nav-link font-semibold text-accent hover:text-accent-light">
              {altLocale.toUpperCase()}
            </a>
          </div>

          <button id="mobile-menu-btn" class="lg:hidden p-2 text-gray-500 hover:text-primary" aria-label="Menú">
            <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
          </button>
        </div>

        <div id="mobile-menu" class="hidden lg:hidden pb-4">
          <div class="flex flex-col gap-0.5 pt-2 border-t border-primary/5">
            <a href={getLocalePath('/marketing-ia', locale)} class="nav-link-mobile">{i.nav.marketing}</a>
            <a href={getLocalePath('/fe', locale)} class="nav-link-mobile">{i.nav.fe}</a>
            <a href={getLocalePath('/politica-cultura', locale)} class="nav-link-mobile">{i.nav.politica}</a>
            <a href={getLocalePath('/musica', locale)} class="nav-link-mobile">{i.nav.musica}</a>
            <a href={getLocalePath('/portafolio', locale)} class="nav-link-mobile">{i.nav.portafolio}</a>
            <a href={getLocalePath('/sobre', locale)} class="nav-link-mobile">{i.nav.sobre}</a>
            <a href={getLocalePath('/contacto', locale)} class="nav-link-mobile">{i.nav.contacto}</a>
            <div class="mt-2 pt-2 border-t border-primary/5">
              <a href={getAltPath()} class="nav-link-mobile font-semibold text-accent">
                🌐 {altLocale === 'en' ? 'English' : 'Español'}
              </a>
            </div>
          </div>
        </div>
      </nav>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-primary text-white/70 mt-20">
      <div class="max-w-content mx-auto px-6 lg:px-8 py-16">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-12">
          <div class="md:col-span-5">
            <p class="font-display text-2xl font-bold text-white mb-3">Ismael Guimarais</p>
            <p class="text-base leading-relaxed text-white/50 max-w-sm">{i.footer.tagline}</p>
          </div>
          <div class="md:col-span-3">
            <p class="font-sans text-xs uppercase tracking-widest text-white/40 mb-4">{i.footer.sections}</p>
            <div class="flex flex-col gap-2 text-sm font-sans">
              <a href={getLocalePath('/marketing-ia', locale)} class="text-white/60 hover:text-white hover:no-underline">{i.nav.marketing}</a>
              <a href={getLocalePath('/fe', locale)} class="text-white/60 hover:text-white hover:no-underline">{i.nav.fe}</a>
              <a href={getLocalePath('/politica-cultura', locale)} class="text-white/60 hover:text-white hover:no-underline">{i.nav.politica}</a>
              <a href={getLocalePath('/musica', locale)} class="text-white/60 hover:text-white hover:no-underline">{i.nav.musica}</a>
              <a href={getLocalePath('/portafolio', locale)} class="text-white/60 hover:text-white hover:no-underline">{i.nav.portafolio}</a>
            </div>
          </div>
          <div class="md:col-span-4">
            <p class="font-sans text-xs uppercase tracking-widest text-white/40 mb-4">{i.footer.social}</p>
            <div class="flex flex-col gap-2 text-sm font-sans">
              <a href="https://youtube.com/@IsmaelGuimarais" target="_blank" rel="noopener" class="text-white/60 hover:text-white hover:no-underline">YouTube</a>
              <a href="https://x.com/IsmaGuimarais" target="_blank" rel="noopener" class="text-white/60 hover:text-white hover:no-underline">X / Twitter</a>
              <a href="https://www.instagram.com/ismaguimarais/" target="_blank" rel="noopener" class="text-white/60 hover:text-white hover:no-underline">Instagram</a>
              <a href="https://open.spotify.com/intl-es/artist/6FBiAmYUgClucZddGctkwd" target="_blank" rel="noopener" class="text-white/60 hover:text-white hover:no-underline">Spotify</a>
            </div>
          </div>
        </div>
        <div class="mt-12 pt-8 border-t border-white/10 flex items-center justify-between text-sm font-sans text-white/30">
          <p>&copy; {new Date().getFullYear()} Ismael Guimarais</p>
          <a href={getAltPath()} class="text-white/50 hover:text-white hover:no-underline">
            {altLocale === 'en' ? '🌐 English' : '🌐 Español'}
          </a>
        </div>
      </div>
    </footer>

    <script>
      const btn = document.getElementById('mobile-menu-btn');
      const menu = document.getElementById('mobile-menu');
      btn?.addEventListener('click', () => {
        menu?.classList.toggle('hidden');
      });
    </script>
  </body>
</html>
