---
interface Props {
  title: string;
  description: string;
  date: Date;
  category: string;
  slug: string;
  image?: string;
}

const { title, description, date, category, slug, image } = Astro.props;

const categoryMap: Record<string, { label: string; class: string; nubismo: string }> = {
  'marketing-ia': { label: 'Marketing & IA', class: 'tag-marketing', nubismo: '/images/ismael/marketing.png' },
  'fe': { label: 'Fe', class: 'tag-fe', nubismo: '/images/ismael/fe.png' },
  'politica-cultura': { label: 'Política y Cultura', class: 'tag-politica', nubismo: '/images/ismael/politic.png' },
  'musica': { label: 'Música', class: 'tag-musica', nubismo: '/images/ismael/music.png' },
};

const cat = categoryMap[category] || { label: category, class: 'tag-marketing', nubismo: '/images/ismael/marketing.png' };
const formattedDate = date.toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' });
const href = `/articulos/${slug}`;
const cardImage = image || cat.nubismo;
---

<a href={href} class="card group block hover:no-underline">
  <div class="relative aspect-[16/10] overflow-hidden">
    <img
      src={cardImage}
      alt={title}
      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
      loading="lazy"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>
  </div>
  <div class="p-5">
    <div class="flex items-center gap-3 mb-3">
      <span class={`tag ${cat.class}`}>{cat.label}</span>
    </div>
    <h3 class="font-display text-lg font-semibold text-primary group-hover:text-accent transition-colors mb-2 leading-snug">{title}</h3>
    <p class="text-sm text-muted font-sans line-clamp-2 mb-3">{description}</p>
    <time datetime={date.toISOString()} class="text-xs text-muted/60 font-sans">{formattedDate}</time>
  </div>
</a>
