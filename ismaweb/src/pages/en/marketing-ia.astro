---
import Base from '../../layouts/Base.astro';
import SectionHero from '../../components/SectionHero.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { t } from '../../i18n/translations';
import { getCollection } from 'astro:content';

const locale = 'en';
const i = t(locale);
const articles = (await getCollection('articulos', ({ data }) => !data.draft && data.category === 'marketing-ia'))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Base title={i.sections.marketing.title} locale={locale}>
  <SectionHero title={i.sections.marketing.title} subtitle={i.sections.marketing.subtitle} image="/images/ismael/marketing.webp" />
  <section class="max-w-content mx-auto px-6 py-16">
    {articles.length > 0 ? (
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {articles.map((article) => (
          <ArticleCard title={article.data.title} description={article.data.description} date={article.data.date} category={article.data.category} slug={article.id} image={article.data.image} />
        ))}
      </div>
    ) : (
      <div class="text-center py-20">
        <p class="text-muted text-xl font-display italic">{i.articlesSoon}</p>
      </div>
    )}
  </section>
</Base>
